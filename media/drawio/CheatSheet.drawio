        <mxCell id="xFenNF8ksm78lh0Gskk3-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Quicksand Medium;fontColor=#424242;fontSize=11;fontStyle=0" value="&lt;div style=&quot;line-height: 190%;&quot;&gt;&lt;div&gt;How large is the team?&lt;/div&gt;&lt;div&gt;Is the turnover rate high?&lt;/div&gt;&lt;div&gt;Is the team familiar with the used technologies?&lt;/div&gt;&lt;div&gt;Does the team have access to technical support?&lt;/div&gt;&lt;/div&gt;" vertex="1">
