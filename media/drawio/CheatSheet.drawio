        <mxCell id="xFenNF8ksm78lh0Gskk3-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Quicksand Medium;fontColor=#424242;fontSize=11;fontStyle=0" value="&lt;div style=&quot;line-height: 190%;&quot;&gt;&lt;div&gt;What is the project&#39;s form factor?&lt;/div&gt;&lt;div&gt;What is the project&#39;s technical size?&lt;/div&gt;&lt;div&gt;How many functional requirements are there?&lt;/div&gt;&lt;div&gt;What is the degree of reuse?&lt;/div&gt;&lt;div&gt;Have the used technologies been demoed before?&lt;/div&gt;&lt;div&gt;How much technical risk can be accepted?&lt;/div&gt;&lt;/div&gt;" vertex="1">
