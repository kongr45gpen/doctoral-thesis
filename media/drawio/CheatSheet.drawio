        <mxCell id="xFenNF8ksm78lh0Gskk3-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Quicksand Medium;fontColor=#424242;fontSize=11;fontStyle=0" value="&lt;div style=&quot;line-height: 190%;&quot;&gt;&lt;div&gt;Which subsystems need to be implemented?&lt;/div&gt;&lt;div&gt;How much miniaturisation is required?&lt;/div&gt;&lt;div&gt;How many features are implemented in HW vs. SW?&lt;/div&gt;&lt;div&gt;Does the project include mechanical elements?&lt;/div&gt;&lt;/div&gt;" vertex="1">
